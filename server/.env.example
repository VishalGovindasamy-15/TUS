ENV=dev
DATABASE_URL=postgresql+asyncpg://trustus:trustus@db:5432/trustus
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
JWT_SECRET=CHANGE_ME__set-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MIN=10
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SMS_PROVIDER=dummy
STORAGE_BACKEND=local
STORAGE_DIR=./storage
PUBLIC_WEB_URL=http://localhost:5173
EAGER_DETECTION=false
IMPOSSIBLE_TRAVEL_KMH_THRESHOLD=150
EXCESSIVE_SCAN_WINDOW_MIN=10
EXCESSIVE_SCAN_MAX=10
VERIFY_RATE_PER_MIN=30
VERIFY_CACHE_TTL_S=30
MULTI_LOCATION_MIN_CELLS=10
MULTI_LOCATION_DAYS=7
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Seeded demo phones (seed script only)
SEED_ADMIN_PHONE=+10000000001
SEED_MFG_PHONE=+10000000002
SEED_DIST_PHONE=+10000000003
SEED_RETAIL_PHONE=+10000000004
SEED_TRANSPORT_PHONE=+10000000005
SEED_SOCIAL_PHONE=+10000000006
